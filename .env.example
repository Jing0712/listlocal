# Copy to .env.local for local dev. In production, set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public base URL of the app (used in emails and Stripe redirects)
APP_URL=http://localhost:3000

# MongoDB Atlas connection string and database name
MONGODB_URI=
MONGODB_DB=listlocal

# Random 32+ character string used to sign session cookies (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# USD per million tokens, used to report cost per listing
ANTHROPIC_PRICE_IN_PER_MTOK=3
ANTHROPIC_PRICE_OUT_PER_MTOK=15

# Email for verification links. Set ONE of these.
# Gmail (recommended for the demo): a Gmail account with 2-Step Verification + an App Password
# (https://myaccount.google.com/apppasswords). Sends to any address, ~500/day.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend: only delivers to your own Resend account email until you verify a domain.
# In local dev with neither set, the verify link is printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=ListLocal <onboarding@resend.dev>

# Stripe (TEST MODE keys only: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Free-plan quota
FREE_LISTING_LIMIT=3
